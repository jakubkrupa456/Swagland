<!DOCTYPE html>
<html lang="pl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>SWAGLAND — Underground Streetwear</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Oswald:wght@400;500;700&family=Inter:wght@400;500;600&display=swap');

  :root {
    --bg: #0a0a0a;
    --bg-elevated: #111111;
    --bg-card: #161616;
    --text: #f0f0f0;
    --text-dim: #888888;
    --text-muted: #555555;
    --accent: #ff2a2a;
    --accent-hover: #ff4444;
    --border: #222222;
    --border-light: #333333;
    --success: #22c55e;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    font-family: 'Inter', sans-serif;
    background: var(--bg);
    color: var(--text);
    line-height: 1.6;
    overflow-x: hidden;
  }

  /* --- NOISE OVERLAY --- */
  .noise {
    position: fixed; top: 0; left: 0; width: 100%; height: 100%;
    pointer-events: none; z-index: 9999; opacity: 0.04;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
  }

  /* --- HEADER --- */
  header {
    position: sticky; top: 0; z-index: 100;
    background: rgba(10,10,10,0.85);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
    padding: 16px 24px;
    display: flex; justify-content: space-between; align-items: center;
  }

  .logo {
    font-family: 'Oswald', sans-serif;
    font-size: 28px; font-weight: 700;
    letter-spacing: 4px;
    color: var(--text);
  }
  .logo span { color: var(--accent); }

  nav { display: flex; gap: 32px; align-items: center; }
  nav a {
    color: var(--text-dim); text-decoration: none;
    font-size: 13px; font-weight: 500; letter-spacing: 1px;
    text-transform: uppercase; transition: color 0.2s;
  }
  nav a:hover { color: var(--text); }

  .cart-btn {
    background: var(--accent); color: #fff; border: none;
    padding: 10px 20px; font-size: 13px; font-weight: 600;
    letter-spacing: 1px; text-transform: uppercase;
    cursor: pointer; transition: background 0.2s;
    font-family: 'Inter', sans-serif;
  }
  .cart-btn:hover { background: var(--accent-hover); }

  /* --- HERO --- */
  .hero {
    min-height: 70vh; display: flex; flex-direction: column;
    justify-content: center; align-items: center;
    text-align: center; padding: 80px 24px;
    position: relative;
  }

  .hero::before {
    content: ''; position: absolute; top: 0; left: 0; right: 0; bottom: 0;
    background: radial-gradient(circle at 50% 50%, rgba(255,42,42,0.08) 0%, transparent 60%);
    pointer-events: none;
  }

  .hero h1 {
    font-family: 'Oswald', sans-serif;
    font-size: clamp(48px, 10vw, 120px);
    font-weight: 700; letter-spacing: 8px;
    line-height: 1; margin-bottom: 16px;
    text-transform: uppercase;
  }
  .hero h1 span { color: var(--accent); }

  .hero p {
    font-size: 16px; color: var(--text-dim);
    max-width: 500px; letter-spacing: 2px;
    text-transform: uppercase; margin-bottom: 40px;
  }

  .hero-btn {
    background: transparent; color: var(--text);
    border: 1px solid var(--border-light); padding: 16px 48px;
    font-size: 13px; font-weight: 600; letter-spacing: 3px;
    text-transform: uppercase; cursor: pointer;
    transition: all 0.3s; font-family: 'Inter', sans-serif;
  }
  .hero-btn:hover {
    border-color: var(--accent); color: var(--accent);
    box-shadow: 0 0 30px rgba(255,42,42,0.15);
  }

  /* --- SECTIONS --- */
  section { padding: 80px 24px; max-width: 1200px; margin: 0 auto; }

  .section-title {
    font-family: 'Oswald', sans-serif;
    font-size: 32px; font-weight: 700;
    letter-spacing: 4px; text-transform: uppercase;
    margin-bottom: 48px; text-align: center;
  }
  .section-title::after {
    content: ''; display: block; width: 60px; height: 2px;
    background: var(--accent); margin: 16px auto 0;
  }

  /* --- PRODUCTS --- */
  .products-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 24px;
  }

  .product-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    transition: all 0.3s; cursor: pointer;
    overflow: hidden;
  }
  .product-card:hover {
    border-color: var(--border-light);
    transform: translateY(-4px);
    box-shadow: 0 12px 40px rgba(0,0,0,0.5);
  }

  .product-img {
    width: 100%; aspect-ratio: 1;
    background: var(--bg-elevated);
    display: flex; align-items: center; justify-content: center;
    position: relative; overflow: hidden;
  }
  .product-img svg { width: 60%; height: 60%; opacity: 0.7; }

  .product-tag {
    position: absolute; top: 12px; left: 12px;
    background: var(--accent); color: #fff;
    padding: 4px 12px; font-size: 10px;
    font-weight: 700; letter-spacing: 2px;
    text-transform: uppercase;
  }

  .product-info { padding: 20px; }
  .product-name {
    font-family: 'Oswald', sans-serif;
    font-size: 18px; font-weight: 500;
    letter-spacing: 1px; text-transform: uppercase;
    margin-bottom: 4px;
  }
  .product-desc {
    font-size: 13px; color: var(--text-muted);
    margin-bottom: 16px;
  }
  .product-footer {
    display: flex; justify-content: space-between; align-items: center;
  }
  .product-price {
    font-size: 18px; font-weight: 700;
    font-variant-numeric: tabular-nums;
  }
  .product-btn {
    background: var(--text); color: var(--bg);
    border: none; padding: 8px 20px;
    font-size: 11px; font-weight: 700;
    letter-spacing: 1px; text-transform: uppercase;
    cursor: pointer; transition: all 0.2s;
    font-family: 'Inter', sans-serif;
  }
  .product-btn:hover { background: var(--accent); color: #fff; }

  /* --- SHIPPING / CONTACT --- */
  .shipping-grid {
    display: grid; grid-template-columns: 1fr 1fr; gap: 48px;
  }

  @media (max-width: 768px) {
    .shipping-grid { grid-template-columns: 1fr; }
    nav { display: none; }
  }

  .shipping-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    padding: 32px;
  }
  .shipping-card h3 {
    font-family: 'Oswald', sans-serif;
    font-size: 20px; letter-spacing: 2px;
    text-transform: uppercase; margin-bottom: 24px;
  }

  .info-row {
    display: flex; align-items: flex-start; gap: 16px;
    margin-bottom: 20px;
  }
  .info-row svg {
    width: 20px; height: 20px; flex-shrink: 0;
    color: var(--accent); margin-top: 2px;
  }
  .info-row div strong {
    display: block; font-size: 13px;
    text-transform: uppercase; letter-spacing: 1px;
    margin-bottom: 4px; color: var(--text);
  }
  .info-row div span {
    font-size: 14px; color: var(--text-dim);
  }

  .contact-form { display: flex; flex-direction: column; gap: 16px; }
  .contact-form input, .contact-form textarea {
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    color: var(--text); padding: 14px 16px;
    font-size: 14px; font-family: 'Inter', sans-serif;
    outline: none; transition: border-color 0.2s;
  }
  .contact-form input:focus, .contact-form textarea:focus {
    border-color: var(--accent);
  }
  .contact-form textarea { min-height: 120px; resize: vertical; }
  .contact-form button {
    background: var(--accent); color: #fff; border: none;
    padding: 16px; font-size: 13px; font-weight: 700;
    letter-spacing: 2px; text-transform: uppercase;
    cursor: pointer; transition: background 0.2s;
    font-family: 'Inter', sans-serif;
  }
  .contact-form button:hover { background: var(--accent-hover); }

  /* --- FOOTER --- */
  footer {
    border-top: 1px solid var(--border);
    padding: 40px 24px; text-align: center;
    color: var(--text-muted); font-size: 12px;
    letter-spacing: 1px; text-transform: uppercase;
  }
  footer a { color: var(--text-dim); text-decoration: none; margin: 0 12px; }
  footer a:hover { color: var(--text); }

  /* --- MARQUEE --- */
  .marquee {
    overflow: hidden; white-space: nowrap;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    padding: 12px 0; background: var(--bg-elevated);
  }
  .marquee-inner {
    display: inline-block;
    animation: scroll 20s linear infinite;
  }
  .marquee span {
    font-family: 'Oswald', sans-serif;
    font-size: 14px; letter-spacing: 4px;
    text-transform: uppercase; color: var(--text-muted);
    padding: 0 40px;
  }
  @keyframes scroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
</style>
<base target="_blank">
</head>
<body>
<div class="noise"></div>

<header>
  <div class="logo">SWAG<span>LAND</span></div>
  <nav>
    <a href="#produkty">Produkty</a>
    <a href="#dostawa">Dostawa</a>
    <a href="#kontakt">Kontakt</a>
  </nav>
  <button class="cart-btn" onclick="alert('Koszyk: 0 produktów')">Koszyk (0)</button>
</header>

<section class="hero">
  <h1>SWAG<span>LAND</span></h1>
  <p>Underground streetwear. Bez kompromisów. Tylko dla tych, którzy wiedzą.</p>
  <button class="hero-btn" onclick="document.getElementById('produkty').scrollIntoView({behavior:'smooth'})">Zobacz kolekcję</button>
</section>

<div class="marquee">
  <div class="marquee-inner">
    <span>🔥 Nowa kolekcja DROP 2026</span><span>🚁 Darmowa dostawa od 200 zł</span><span>💀 Limited edition — tylko 50 sztuk</span><span>🔥 Nowa kolekcja DROP 2026</span><span>🚁 Darmowa dostawa od 200 zł</span><span>💀 Limited edition — tylko 50 sztuk</span>
  </div>
</div>

<section id="produkty">
  <h2 class="section-title">Kolekcja</h2>
  <div class="products-grid">

    <div class="product-card">
      <div class="product-img">
        <span class="product-tag">Nowość</span>
        <svg viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M30 20 L70 20 L75 80 L25 80 Z" />
          <path d="M35 20 L35 12 Q35 8 40 8 L60 8 Q65 8 65 12 L65 20" />
          <path d="M30 35 L70 35" stroke-dasharray="4 2"/>
          <text x="50" y="58" text-anchor="middle" font-size="10" fill="currentColor" stroke="none" font-family="Oswald,sans-serif">SWAG</text>
        </svg>
      </div>
      <div class="product-info">
        <div class="product-name">Shadow Tee</div>
        <div class="product-desc">Czarna koszulka z nadrukiem UV-reactive</div>
        <div class="product-footer">
          <span class="product-price">129 zł</span>
          <button class="product-btn">Dodaj</button>
        </div>
      </div>
    </div>

    <div class="product-card">
      <div class="product-img">
        <span class="product-tag">Bestseller</span>
        <svg viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M30 20 L70 20 L75 80 L25 80 Z" />
          <path d="M35 20 L35 12 Q35 8 40 8 L60 8 Q65 8 65 12 L65 20" />
          <circle cx="50" cy="50" r="14" />
          <path d="M50 40 L50 60 M40 50 L60 50" />
        </svg>
      </div>
      <div class="product-info">
        <div class="product-name">Void Walker</div>
        <div class="product-desc">Oversized fit, 280g bawełna</div>
        <div class="product-footer">
          <span class="product-price">149 zł</span>
          <button class="product-btn">Dodaj</button>
        </div>
      </div>
    </div>

    <div class="product-card">
      <div class="product-img">
        <svg viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M30 20 L70 20 L75 80 L25 80 Z" />
          <path d="M35 20 L35 12 Q35 8 40 8 L60 8 Q65 8 65 12 L65 20" />
          <path d="M38 45 L50 35 L62 45 L58 58 L42 58 Z" />
        </svg>
      </div>
      <div class="product-info">
        <div class="product-name">Neon Ghost</div>
        <div class="product-desc">Fluorescent print, ciemna baza</div>
        <div class="product-footer">
          <span class="product-price">139 zł</span>
          <button class="product-btn">Dodaj</button>
        </div>
      </div>
    </div>

    <div class="product-card">
      <div class="product-img">
        <span class="product-tag">Limitowana</span>
        <svg viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M30 20 L70 20 L75 80 L25 80 Z" />
          <path d="M35 20 L35 12 Q35 8 40 8 L60 8 Q65 8 65 12 L65 20" />
          <rect x="40" y="40" width="20" height="20" transform="rotate(45 50 50)" />
        </svg>
      </div>
      <div class="product-info">
        <div class="product-name">Red Pill</div>
        <div class="product-desc">Kolekcja specjalna, numerowana</div>
        <div class="product-footer">
          <span class="product-price">199 zł</span>
          <button class="product-btn">Dodaj</button>
        </div>
      </div>
    </div>

    <div class="product-card">
      <div class="product-img">
        <svg viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M30 20 L70 20 L75 80 L25 80 Z" />
          <path d="M35 20 L35 12 Q35 8 40 8 L60 8 Q65 8 65 12 L65 20" />
          <path d="M42 48 Q50 38 58 48 Q50 62 42 48" />
        </svg>
      </div>
      <div class="product-info">
        <div class="product-name">Underground</div>
        <div class="product-desc">Minimal, heavy cotton</div>
        <div class="product-footer">
          <span class="product-price">119 zł</span>
          <button class="product-btn">Dodaj</button>
        </div>
      </div>
    </div>

    <div class="product-card">
      <div class="product-img">
        <svg viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M30 20 L70 20 L75 80 L25 80 Z" />
          <path d="M35 20 L35 12 Q35 8 40 8 L60 8 Q65 8 65 12 L65 20" />
          <path d="M38 42 L46 58 L54 42 L62 58" />
        </svg>
      </div>
      <div class="product-info">
        <div class="product-name">System Error</div>
        <div class="product-desc">Glitch art print, unisex</div>
        <div class="product-footer">
          <span class="product-price">159 zł</span>
          <button class="product-btn">Dodaj</button>
        </div>
      </div>
    </div>

  </div>
</section>

<section id="dostawa">
  <h2 class="section-title">Dostawa & Kontakt</h2>
  <div class="shipping-grid">

    <div class="shipping-card">
      <h3>📦 Wysyłka</h3>
      <div class="info-row">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 21V5a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v16"/></svg>
        <div>
          <strong>InPost Paczkomat</strong>
          <span>14,99 zł — dostawa w 24h</span>
        </div>
      </div>
      <div class="info-row">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
        <div>
          <strong>Kurier DHL / DPD</strong>
          <span>19,99 zł — dostawa w 24-48h</span>
        </div>
      </div>
      <div class="info-row">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
        <div>
          <strong>Odbiór osobisty</strong>
          <span>0 zł — Warszawa, ul. Underground 66</span>
        </div>
      </div>
      <div class="info-row">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        <div>
          <strong>Darmowa dostawa</strong>
          <span>Przy zamówieniach powyżej 200 zł</span>
        </div>
      </div>
    </div>

    <div class="shipping-card" id="kontakt">
      <h3>📮 Dane kontaktowe</h3>
      <div class="info-row">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
        <div>
          <strong>E-mail</strong>
          <span>kontakt@swagland.pl</span>
        </div>
      </div>
      <div class="info-row">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        <div>
          <strong>Telefon</strong>
          <span>+48 666 999 000</span>
        </div>
      </div>
      <div class="info-row">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
        <div>
          <strong>Adres</strong>
          <span>Swagland Sp. z o.o.<br>ul. Underground 66<br>00-666 Warszawa</span>
        </div>
      </div>
      <div class="info-row">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
        <div>
          <strong>NIP</strong>
          <span>123-456-78-90</span>
        </div>
      </div>
    </div>

  </div>
</section>

<section>
  <h2 class="section-title">Napisz do nas</h2>
  <div class="shipping-card" style="max-width:600px;margin:0 auto;">
    <form class="contact-form" onsubmit="event.preventDefault(); alert('Wiadomość wysłana! Odpiszemy w ciągu 24h.');">
      <input type="text" placeholder="Imię / Nazwa" required>
      <input type="email" placeholder="E-mail" required>
      <input type="text" placeholder="Temat">
      <textarea placeholder="Twoja wiadomość..." required></textarea>
      <button type="submit">Wyślij wiadomość</button>
    </form>
  </div>
</section>

<footer>
  <p>© 2026 SWAGLAND. Wszystkie prawa zastrzeżone.</p>
  <p style="margin-top:12px;">
    <a href="#">Regulamin</a>
    <a href="#">Polityka prywatności</a>
    <a href="#">Zwroty</a>
  </p>
</footer>

</body>
</html>
